From: BrightSign NPU Extension <dev@brightsign.biz>
Date: Sun, 17 Nov 2025 00:00:00 +0000
Subject: [PATCH] Fix CMake string REGEX REPLACE command for empty GIT_USER

The string REGEX REPLACE command fails when GIT_USER is empty or contains
special characters. Add a check to ensure GIT_USER is valid before processing.

Upstream-Status: Pending

--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -61,7 +61,11 @@ if(GIT_EXECUTABLE)
     OUTPUT_VARIABLE GIT_HOST
     OUTPUT_STRIP_TRAILING_WHITESPACE
     )
-	string(REGEX REPLACE "([^\\])[\\]([^\\])" "\\1\\\\\\\\\\2" GIT_USER ${GIT_USER})
+    # Only process GIT_USER if it's not empty to avoid CMake string REGEX errors
+    if(GIT_USER)
+        string(REGEX REPLACE "([^\\\\])[\\\\]([^\\\\])" "\\1\\\\\\\\\\\\\\2" GIT_USER ${GIT_USER})
+    endif()
+    
     set(LWS_BUILD_HASH ${GIT_USER}@${GIT_HOST}-${GIT_HASH})
     message("Git commit hash: ${LWS_BUILD_HASH}")
 endif()
