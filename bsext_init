#!/bin/bash
### BEGIN INIT INFO
# Provides:          bsext-argus
# Required-Start:    $remote_fs $syslog
# Required-Stop:     $remote_fs $syslog
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
# Short-Description: BrightSign Argus Detection Extension
# Description:       Runs the BrightSign NPU-based argus detection service
### END INIT INFO

# Source function library if it exists
[ -f /etc/init.d/functions ] && . /etc/init.d/functions

SCRIPT_PATH=$(dirname $(realpath $0))

# CRITICAL FIX: Replace 'gaze' with 'argus' in path if present
# This handles the case where the directory was renamed but paths still reference old name
SCRIPT_PATH=$(echo "$SCRIPT_PATH" | sed 's/ext_npu_gaze/ext_npu_argus/g')

DAEMON_NAME="bsext-argus"
PIDFILE="/var/run/${DAEMON_NAME}.pid"
STREAM_SERVER_PIDFILE="/var/run/bsext-image-stream-server.pid"
MQTT_BROKER_PIDFILE="/var/run/bsext-mosquitto.pid"
ARGUS_EXPORTER_PIDFILE="/var/run/bsext-argus-exporter.pid"

# defaults -- these can be overridden by environment variables
DISABLE_AUTO_START=false

# Auto-detection will automatically find the best available video source:
# Priority: Command line args > Registry settings > Auto-discovered RTSP > USB cameras > Default device
# 
# Registry settings:
#   bsext-argus-video-device : RTSP URL or device name (e.g., rtsp://192.168.0.203:8554/mystream or /dev/video0)
#   bsext-argus-rtsp-server  : RTSP server IP:port (e.g., 192.168.0.203:8554)
#
# Examples:
#   registry write extension bsext-argus-rtsp-server 192.168.0.203:8554
#   registry write extension bsext-argus-video-device rtsp://192.168.0.203:8554/mystream

# Common setup function to determine SOC model and video device
get_soc_name() {
    # figure out the SOC model -- default to RK3588
    SOC_NAME=RK3588
    if [ -f /sys/firmware/devicetree/base/compatible ]; then
        # Use strings command to handle null bytes in devicetree properly
        COMPATIBLE=$(strings /sys/firmware/devicetree/base/compatible 2>/dev/null)
        
        # Look for rockchip,rk3588 pattern in the compatible string
        if echo "$COMPATIBLE" | grep -q "rockchip,rk3588"; then
            SOC_NAME="RK3588"
        fi

        # Look for rockchip,rk3576 pattern in the compatible string
        if echo "$COMPATIBLE" | grep -q "rockchip,rk3576"; then
            SOC_NAME="RK3576"
        fi

        # Look for rockchip,rk3568 pattern in the compatible string
        if echo "$COMPATIBLE" | grep -q "rockchip,rk3568"; then
            SOC_NAME="RK3568"
        fi
    else
        # In development environments or non-XT5 hardware, default to RK3588
        echo "WARNING: Unable to determine SOC model, defaulting to RK3588 for development" >&2
    fi

    # Return the SOC model
    echo "${SOC_NAME}"
}

detect_video_sources() {
    echo "Legacy video source detection (fallback only)..." >&2
    
    # Array to store found sources
    DETECTED_SOURCES=""
    
    # Check for USB cameras
    echo "  Checking for USB cameras..." >&2
    for video_dev in /dev/video*; do
        # Skip non-numeric video devices
        if ! echo "$video_dev" | grep -q '/dev/video[0-9]'; then
            continue
        fi
        
        if [ -c "$video_dev" ]; then
            # More thorough validation - try to query device capabilities
            if command -v v4l2-ctl >/dev/null 2>&1; then
                # Use v4l2-ctl to check if it's a real camera
                if v4l2-ctl --device="$video_dev" --list-formats-ext >/dev/null 2>&1; then
                    echo "  Found USB camera: $video_dev" >&2
                    DETECTED_SOURCES="$DETECTED_SOURCES $video_dev"
                else
                    echo "  Device $video_dev exists but is not a functional camera" >&2
                fi
            else
                # Fallback: try to open the device briefly to test if it's functional
                if timeout 2 cat "$video_dev" >/dev/null 2>&1; then
                    echo "   Found USB camera: $video_dev" >&2
                    DETECTED_SOURCES="$DETECTED_SOURCES $video_dev"
                else
                    echo "  Device $video_dev exists but is not accessible" >&2
                fi
            fi
        fi
    done
    
    echo "  Legacy detection complete. Found sources: '$DETECTED_SOURCES'" >&2
    echo "$DETECTED_SOURCES"
}

# Function to get the video source from registry or default
get_video_source() {
    local video_source
    video_source=$(registry extension ${DAEMON_NAME}-video-device)
    echo "Video source from registry: '$video_source'" >&2
    if [ -z "$video_source" ]; then
        video_source="usb_camera"
    fi
    echo "$video_source"
}

# Common function to run the attention demo
run_attention_demo() {
    # Get command arguments from setup function
    # CMD_ARGS=$(get_runtime_args)
    # echo "Using Model and Device: ${CMD_ARGS}"

    SOC_NAME=$(get_soc_name)
    SOC_HOME=${SCRIPT_PATH}/${SOC_NAME}
    cd ${SOC_HOME}

    # NOTE: DO NOT pass video source as positional argument - it overrides registry!
    # The application will automatically read bsext-gaze-video-device from registry
    # 
    # NOTE: DO NOT pass config.json as argument - let app use its own search logic:
    #   1. CLI: --config <path>
    #   2. ENV: $BSEXT_CONFIG  
    #   3. SD:  /storage/sd/configs/config.json (writable override)
    #   4. PKG: ${SOC_HOME}/configs/config.json (read-only default)
    CMD_ARGS="${SOC_HOME}/model/RetinaFace.rknn"
    echo "Using Model: RetinaFace.rknn"
    echo "Config will be auto-detected (priority: SD card > package default)"
    echo "Video source will be read from registry: bsext-gaze-video-device"
    
    # Debug: Show exactly what we're passing to attention_demo
    echo "DEBUG: SOC_HOME = ${SOC_HOME}"
    echo "DEBUG: Registry video source = $(get_video_source)"
    echo "DEBUG: Complete CMD_ARGS = ${CMD_ARGS}"
    echo "DEBUG: About to execute: ${SOC_HOME}/attention_demo ${CMD_ARGS}"
    
    # Default to running in foreground
    local background=$1
    
    # LD_LIBRARY_PATH is already set by setup_gstreamer_env, which includes bin/ directory
    # No need to override it here
    if [ "$background" = "true" ]; then
        # Run as a daemon in the background with auto-restart on config change
        echo "DEBUG: Starting daemon with auto-restart support"
        echo "DEBUG: Executable: ${SOC_HOME}/attention_demo"
        echo "DEBUG: Arguments: ${CMD_ARGS}"
        
        # Create a wrapper script that handles exit code 42 (config change)
        cat > /tmp/attention_demo_wrapper.sh << 'WRAPPER_EOF'
#!/bin/bash
# Auto-restart wrapper for attention_demo
# Restarts on exit code 42 (config change detected)

SOC_HOME="$1"
shift
CMD_ARGS="$@"

while true; do
    echo "[$(date)] Starting attention_demo..."
    ${SOC_HOME}/attention_demo ${CMD_ARGS}
    EXIT_CODE=$?
    
    if [ $EXIT_CODE -eq 42 ]; then
        echo "[$(date)] Config change detected (exit code 42), restarting in 2 seconds..."
        sleep 2
    else
        echo "[$(date)] attention_demo exited with code $EXIT_CODE, stopping."
        break
    fi
done
WRAPPER_EOF
        chmod +x /tmp/attention_demo_wrapper.sh
        
        echo "DEBUG: Full command: start-stop-daemon --start --background --make-pidfile --pidfile ${PIDFILE} --exec /tmp/attention_demo_wrapper.sh -- ${SOC_HOME} ${CMD_ARGS}"
        start-stop-daemon --start --background --make-pidfile --pidfile ${PIDFILE} \
                          --exec /tmp/attention_demo_wrapper.sh -- ${SOC_HOME} ${CMD_ARGS}
    else
        # Run directly in foreground with auto-restart on config change
        echo "DEBUG: Running in foreground with auto-restart support"
        echo "DEBUG: Executable: ${SOC_HOME}/attention_demo"
        echo "DEBUG: Arguments: ${CMD_ARGS}"
        echo "DEBUG: Full command: ${SOC_HOME}/attention_demo ${CMD_ARGS}"
        
        # Auto-restart loop for foreground mode
        while true; do
            ${SOC_HOME}/attention_demo ${CMD_ARGS}
            EXIT_CODE=$?
            
            if [ $EXIT_CODE -eq 42 ]; then
                echo "[$(date)] Config change detected (exit code 42), restarting in 2 seconds..."
                sleep 2
            else
                echo "[$(date)] attention_demo exited with code $EXIT_CODE"
                break
            fi
        done
    fi
}

run_stream_server() {
    # Default to running in foreground
    echo "run_stream_server called with background=$1"
    local background=$1
    local port=$2
    echo "run_stream_server called with port=${port}"

    SOC_NAME=$(get_soc_name)
    SOC_HOME=${SCRIPT_PATH}/${SOC_NAME}

    if [ "$background" = "true" ]; then
        # Run as a daemon in the background
        echo "start-stop daemon =${SOC_HOME}/image-stream-server"
        start-stop-daemon --start --background --make-pidfile --pidfile ${STREAM_SERVER_PIDFILE} \
                          --exec ${SOC_HOME}/image-stream-server -- -port ${port}
    else
        # Run directly in foreground
        ${SOC_HOME}/image-stream-server -port ${port}
    fi
}

run_argus_exporter() {
    echo "run_argus_exporter called with background=$1"
    local background=$1

    SOC_NAME=$(get_soc_name)
    SOC_HOME=${SCRIPT_PATH}/${SOC_NAME}

    if [ "$background" = "true" ]; then
        # Run as a daemon in the background
        echo "Starting argus-exporter (will use default config search paths)"
        start-stop-daemon --start --background --make-pidfile --pidfile ${ARGUS_EXPORTER_PIDFILE} \
                          --exec ${SOC_HOME}/argus-exporter
    else
        # Run directly in foreground
        ${SOC_HOME}/argus-exporter
    fi
}

run_mqtt_broker() {
    echo "run_mqtt_broker called with background=$1"
    local background=$1
    local port=${2:-1883}  # Default MQTT port
    echo "run_mqtt_broker called with port=${port}"
    
    SOC_NAME=$(get_soc_name)
    SOC_HOME=${SCRIPT_PATH}/${SOC_NAME}
    
    # Create minimal mosquitto config if it doesn't exist
    local mqtt_conf="/tmp/mosquitto_${port}.conf"
    cat > ${mqtt_conf} <<EOF
# Minimal mosquitto configuration for extension
listener ${port} 0.0.0.0
allow_anonymous true
persistence false
log_dest stdout
log_type error
log_type warning
EOF
    
    if [ "$background" = "true" ]; then
        # Run as a daemon in the background
        echo "Starting MQTT broker on port ${port}"
        start-stop-daemon --start --background --make-pidfile --pidfile ${MQTT_BROKER_PIDFILE} \
                          --exec ${SOC_HOME}/bin/mosquitto -- -c ${mqtt_conf}
    else
        # Run directly in foreground
        ${SOC_HOME}/bin/mosquitto -c ${mqtt_conf}
    fi
}

setup_gstreamer_env() {
    echo "Setting up GStreamer environment for SOC: $SOC_NAME"
    
    # CRITICAL: Bundled plugins MUST come FIRST
    # ext-bundle includes RTSP plugins + libgstcoreelements.so (queue)
    # All plugins are from same GStreamer version for compatibility
    export GST_PLUGIN_PATH=/var/volatile/bsext/ext_npu_argus/$SOC_NAME/lib/gstreamer-1.0:/usr/lib/gstreamer-1.0
    export GST_PLUGIN_SYSTEM_PATH=$GST_PLUGIN_PATH
    
    # Include MQTT bin directory first so mosquitto utilities find their libraries
    # Also include bin directory for all other shared libraries
    export LD_LIBRARY_PATH=/var/volatile/bsext/ext_npu_argus/$SOC_NAME/bin:/var/volatile/bsext/ext_npu_argus/$SOC_NAME/lib:/usr/lib:$LD_LIBRARY_PATH
    export GST_REGISTRY="/tmp/gst-registry.bin"
    export GST_PLUGIN_SCANNER="/usr/libexec/gstreamer-1.0/gst-plugin-scanner"
    export GST_REGISTRY_REUSE_PLUGIN_SCANNER=1
    export GST_DEBUG_NO_COLOR=1
    
    # Force GStreamer to rescan plugins by clearing old registry
    rm -f /tmp/gst-registry.bin
    echo "  Cleared GStreamer registry - will rescan plugins on startup"
    echo "  GST_PLUGIN_PATH=$GST_PLUGIN_PATH"
    echo "  GST_PLUGIN_SYSTEM_PATH=$GST_PLUGIN_SYSTEM_PATH"
    echo "  LD_LIBRARY_PATH=$LD_LIBRARY_PATH"
    echo "  GST_REGISTRY=$GST_REGISTRY"
    echo "  GST_PLUGIN_SCANNER=$GST_PLUGIN_SCANNER"
    echo "  GST_REGISTRY_REUSE_PLUGIN_SCANNER=$GST_REGISTRY_REUSE_PLUGIN_SCANNER"
    echo "  MQTT utilities available in: /var/volatile/bsext/ext_npu_argus/$SOC_NAME/bin/"
}

# Setup Argus dashboard for Grafana auto-provisioning
# This ensures the Argus People Analytics dashboard is automatically installed
# when the prometheus-grafana-extension is also present
setup_argus_dashboard() {
    echo "Setting up Argus Grafana dashboard..."

    # Source dashboard location in this extension
    local SRC_DASHBOARD="${SCRIPT_PATH}/configs/dashboards/argus-analytics.json"

    # Check if source file exists
    if [ ! -f "${SRC_DASHBOARD}" ]; then
        echo "  WARNING: Dashboard file not found: ${SRC_DASHBOARD}"
        return 1
    fi

    # Target: prometheus-grafana-extension's dashboard directory
    # This directory is watched by the existing 'BrightSign' provisioner with updateIntervalSeconds: 30
    # Grafana will automatically pick up new JSON files without needing a restart
    local PROMGRAF_DASHBOARDS="/var/volatile/bsext/ext_promgraf/configs/dashboards"

    # Check if prometheus-grafana-extension is installed
    if [ -d "${PROMGRAF_DASHBOARDS}" ]; then
        cp "${SRC_DASHBOARD}" "${PROMGRAF_DASHBOARDS}/" 2>/dev/null && \
            echo "  Installed: ${PROMGRAF_DASHBOARDS}/argus-analytics.json" && \
            echo "  Dashboard will appear in Grafana within 30 seconds" || \
            echo "  WARNING: Could not copy dashboard file"
    else
        echo "  prometheus-grafana-extension not found at ${PROMGRAF_DASHBOARDS}"
        echo "  Argus dashboard will not be auto-installed"
        echo "  Install prometheus-grafana-extension first, then restart this extension"
    fi
}

do_start() {
    # check registry for auto-start
    reg_disable_auto_start=$(registry extension ${DAEMON_NAME}-disable-auto-start)
    if [ -n "${reg_disable_auto_start}" ]; then
        DISABLE_AUTO_START=${reg_disable_auto_start}
    fi

    if [ "${DISABLE_AUTO_START}" = "true" ]; then
        echo "Auto-start is disabled for ${DAEMON_NAME}"
        return
    fi

    # CRITICAL: Kill any existing processes before starting new ones
    # This prevents orphaned processes and stale PID files
    echo "Checking for existing processes before starting..."
    if pgrep -f "attention_demo" >/dev/null 2>&1; then
        echo "  Found existing attention_demo process, killing it..."
        pkill -9 -f "attention_demo" 2>/dev/null || true
        sleep 1
    fi
    if pgrep -f "image-stream-server" >/dev/null 2>&1; then
        echo "  Found existing image-stream-server process, killing it..."
        pkill -9 -f "image-stream-server" 2>/dev/null || true
        sleep 1
    fi
    if pgrep -f "mosquitto.*bsext" >/dev/null 2>&1; then
        echo "  Found existing mosquitto process, killing it..."
        pkill -9 -f "mosquitto.*bsext" 2>/dev/null || true
        sleep 1
    fi
    if pgrep -f "argus-exporter" >/dev/null 2>&1; then
        echo "  Found existing argus-exporter process, killing it..."
        pkill -9 -f "argus-exporter" 2>/dev/null || true
        sleep 1
    fi

    # Clean up stale PID files
    rm -f ${PIDFILE} ${STREAM_SERVER_PIDFILE} ${MQTT_BROKER_PIDFILE} ${ARGUS_EXPORTER_PIDFILE} 2>/dev/null || true

    SOC_NAME=$(get_soc_name)
    setup_gstreamer_env

    # Setup Argus dashboard for Grafana (if prometheus-grafana-extension is present)
    setup_argus_dashboard

    # Start MQTT broker first (so it's ready when attention_demo starts)
    MQTT_PORT=1883  # default MQTT port
    reg_mqtt_port=$(registry networking bs-mqtt-broker-port)
    if [ -n "${reg_mqtt_port}" ] && [ "${reg_mqtt_port}" != "0" ]; then
        MQTT_PORT=${reg_mqtt_port}
    fi
    
    if [ "${MQTT_PORT}" != "0" ]; then
        echo "Starting MQTT broker on port ${MQTT_PORT}"
        run_mqtt_broker true ${MQTT_PORT}
    else
        echo "MQTT broker is disabled (port set to 0)"
    fi

    # Start the attention_demo process as a daemon
    run_attention_demo true

    STREAM_SERVER_PORT=20200  # default port for image stream server
    reg_stream_server_port=$(registry networking bs-image-stream-server-port)
    echo "Starting image stream server on port ${reg_stream_server_port}"
    if [ -n "${reg_stream_server_port}" ]; then
        STREAM_SERVER_PORT=${reg_stream_server_port}
    fi

    if [ "${STREAM_SERVER_PORT}" = "0" ]; then
        echo "Image stream server is disabled (port set to 0)"
    else
        # Start the image stream server process as a daemon
        run_stream_server true ${STREAM_SERVER_PORT}
    fi

    # Start argus-exporter (Prometheus metrics exporter)
    # Check if disabled via registry (set port to 0 to disable)
    reg_exporter_disabled=$(registry networking bs-argus-exporter-port)
    if [ "${reg_exporter_disabled}" = "0" ]; then
        echo "Argus exporter is disabled (registry bs-argus-exporter-port=0)"
    else
        echo "Starting argus-exporter..."
        run_argus_exporter true
    fi
}

do_stop() {
    echo "Stopping ${DAEMON_NAME} services..."
    
    # Stop attention_demo - use multiple methods to ensure it's killed
    echo "Stopping attention_demo..."
    
    # Method 1: Try PID file first (current name)
    if [ -f "${PIDFILE}" ]; then
        echo "  Killing by PID file: ${PIDFILE}"
        local pid=$(cat ${PIDFILE} 2>/dev/null)
        if [ -n "$pid" ]; then
            echo "  Killing process $pid (from PID file)..."
            kill -9 $pid 2>/dev/null || true
            # Also kill any child processes
            pkill -9 -P $pid 2>/dev/null || true
        fi
        rm -f ${PIDFILE}
    fi
    
    # Method 2: Check for legacy PID file
    if [ -f "/var/run/bsext-gaze.pid" ]; then
        echo "  Killing by legacy PID file: /var/run/bsext-gaze.pid"
        local pid=$(cat /var/run/bsext-gaze.pid 2>/dev/null)
        if [ -n "$pid" ]; then
            echo "  Killing process $pid (from legacy PID file)..."
            kill -9 $pid 2>/dev/null || true
            pkill -9 -P $pid 2>/dev/null || true
        fi
        rm -f /var/run/bsext-gaze.pid
    fi
    
    # Method 3: Kill ALL attention_demo processes by name (handles multiple instances)
    echo "  Killing all attention_demo processes by name..."
    pkill -9 -f "attention_demo" 2>/dev/null || true
    killall -9 attention_demo 2>/dev/null || true
    
    # Method 4: Extra thorough - find and kill by exact path
    ps | grep "attention_demo" | grep -v grep | awk '{print $1}' | xargs -r kill -9 2>/dev/null || true
    
    # Wait and verify it's stopped (with retry loop)
    local retry_count=0
    local max_retries=3
    while [ $retry_count -lt $max_retries ]; do
        sleep 1
        if ! pgrep -f "attention_demo" >/dev/null 2>&1; then
            echo "  attention_demo stopped successfully"
            break
        fi
        
        retry_count=$((retry_count + 1))
        if [ $retry_count -lt $max_retries ]; then
            echo "  WARNING: attention_demo still running (attempt $retry_count/$max_retries), retrying..."
            pkill -9 -f "attention_demo" 2>/dev/null || true
            killall -9 attention_demo 2>/dev/null || true
            ps | grep "attention_demo" | grep -v grep | awk '{print $1}' | xargs -r kill -9 2>/dev/null || true
        else
            echo "  ERROR: Failed to stop attention_demo after $max_retries attempts!"
            echo "  Showing remaining processes:"
            ps | grep "attention_demo" | grep -v grep || true
        fi
    done

    # Stop image-stream-server (ALWAYS kill by name to handle all instances)
    echo "Stopping image-stream-server..."
    
    # Kill ALL image-stream-server processes by name (handles truncated names in ps)
    # Use multiple patterns to catch truncated process names
    echo "  Searching for image-stream-server processes..."
    pkill -9 -f "image-stream-se" 2>/dev/null || true
    pkill -9 -f "image-stream-server" 2>/dev/null || true
    killall -9 image-stream-server 2>/dev/null || true
    
    # Also try PID file if it exists (for cleanup)
    if [ -f "${STREAM_SERVER_PIDFILE}" ]; then
        local pid=$(cat ${STREAM_SERVER_PIDFILE} 2>/dev/null)
        if [ -n "$pid" ]; then
            echo "  Also killing PID $pid from PID file..."
            kill -9 $pid 2>/dev/null || true
            pkill -9 -P $pid 2>/dev/null || true
        fi
        rm -f ${STREAM_SERVER_PIDFILE}
    fi
    
    # Give processes time to die
    sleep 1
    
    # Verify image-stream-server is stopped (check for truncated name too)
    if ps | grep -E "image-stream|image-stream-se" | grep -v grep >/dev/null 2>&1; then
        echo "  WARNING: image-stream-server still running! Showing processes:"
        ps | grep -E "image-stream|image-stream-se" | grep -v grep
        echo "  Forcing final kill..."
        ps | grep -E "image-stream|image-stream-se" | grep -v grep | awk '{print $1}' | xargs -r kill -9 2>/dev/null || true
        sleep 1
        if ps | grep -E "image-stream|image-stream-se" | grep -v grep >/dev/null 2>&1; then
            echo "  ERROR: Failed to stop image-stream-server after multiple attempts!"
        else
            echo "  image-stream-server stopped successfully (after forced kill)"
        fi
    else
        echo "  image-stream-server stopped successfully"
    fi

    # Stop argus-exporter
    echo "Stopping argus-exporter..."
    pkill -9 -f "argus-exporter" 2>/dev/null || true
    killall -9 argus-exporter 2>/dev/null || true

    if [ -f "${ARGUS_EXPORTER_PIDFILE}" ]; then
        local pid=$(cat ${ARGUS_EXPORTER_PIDFILE} 2>/dev/null)
        if [ -n "$pid" ]; then
            echo "  Also killing PID $pid from PID file..."
            kill -9 $pid 2>/dev/null || true
            pkill -9 -P $pid 2>/dev/null || true
        fi
        rm -f ${ARGUS_EXPORTER_PIDFILE}
    fi
    echo "  argus-exporter stopped"

    # Stop mosquitto broker
    if [ -f "${MQTT_BROKER_PIDFILE}" ]; then
        echo "Stopping mosquitto broker (PID file: ${MQTT_BROKER_PIDFILE})"
        local pid=$(cat ${MQTT_BROKER_PIDFILE} 2>/dev/null)
        if [ -n "$pid" ]; then
            echo "Killing process $pid with SIGKILL..."
            kill -9 $pid 2>/dev/null || true
            # Also kill any child processes
            pkill -9 -P $pid 2>/dev/null || true
        fi
        rm -f ${MQTT_BROKER_PIDFILE}
    else
        echo "No PID file found for mosquitto, trying to kill by name..."
        pkill -9 -f "mosquitto" || true
    fi
    
    # Verify mosquitto is stopped
    sleep 1
    if pgrep -f "mosquitto" >/dev/null 2>&1; then
        echo "WARNING: mosquitto still running, forcing kill by name..."
        pkill -9 -f "mosquitto" || true
        sleep 1
    fi
    
    echo "Stop complete"
}

# Parse command line arguments first (they take priority over config file)
ACTION=""
while [ $# -gt 0 ]; do
    case "$1" in
        --rtsp-url)
            RTSP_HINT="$2"
            shift 2
            ;;
        --rtsp-server)
            RTSP_HINT="$2"
            shift 2
            ;;
        start|stop|restart|run|detect)
            ACTION="$1"
            shift
            ;;
        *)
            if [ -z "$ACTION" ]; then
                ACTION="$1"
            fi
            shift
            ;;
    esac
done

# Default to help if no action specified
if [ -z "$ACTION" ]; then
    ACTION="help"
fi

case "$ACTION" in
    start)
        echo "Starting ${DAEMON_NAME}"
        do_start
        ;;
    stop)
        echo "Stopping ${DAEMON_NAME}"
        do_stop
        ;;
    restart)
        echo "Restarting ${DAEMON_NAME}"
        do_stop
        do_start
        ;;
    run)
        echo "Running ${DAEMON_NAME} in foreground"
        # Run directly in foreground (not as daemon)
        run_attention_demo false
        run_stream_server false 20200
        ;;
    detect)
        echo "Detecting available video sources..."
        SOURCES=$(detect_video_sources)
        if [ -n "$SOURCES" ] && [ "$SOURCES" != " " ]; then
            echo ""
            echo "Found video sources:"
            # Parse sources properly (space-separated)
            for source in $SOURCES; do
                if [ -n "$source" ]; then
                    echo "  - $source"
                fi
            done
            echo ""
            echo "The system will automatically select the best source:"
            SELECTED=$(get_video_source)
            echo "  Selected: $SELECTED"
        else
            echo "No video sources detected."
            
        fi
        ;;
    help|*)
        echo "Usage: $0 {start|stop|restart|run|detect} [options]"
        echo ""
        echo "Actions:"
        echo "  start     Start the argus detection service as a daemon"
        echo "  stop      Stop the argus detection service"
        echo "  restart   Restart the argus detection service"
